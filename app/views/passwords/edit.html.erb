<% content_for :title, "パスワードの再設定 — おやつ貯金" %>

<div class="app-shell">
  <header class="topbar">
    <h1>パスワードを再設定</h1>
    <p class="sub">新しいパスワードを設定してください。</p>
  </header>

  <main class="content">
    <%= render "shared/flash" %>

    <section class="card">
      <%= form_with url: password_path(params[:token]), method: :put do |form| %>
        <div class="field">
          <%= form.label :password, "新しいパスワード", class: "field-label" %>
          <%= form.password_field :password,
                                  required: true, autofocus: true,
                                  autocomplete: "new-password",
                                  maxlength: 72,
                                  placeholder: "新しいパスワード",
                                  class: "input" %>
        </div>

        <div class="field">
          <%= form.label :password_confirmation, "パスワード（確認）", class: "field-label" %>
          <%= form.password_field :password_confirmation,
                                  required: true,
                                  autocomplete: "new-password",
                                  maxlength: 72,
                                  placeholder: "もう一度入力",
                                  class: "input" %>
        </div>

        <%= form.submit "パスワードを更新する", class: "btn-primary" %>
      <% end %>
    </section>
  </main>
</div>
