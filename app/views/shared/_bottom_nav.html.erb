<%# locals: (active: :home) %>
<nav class="bottom-nav" role="navigation" aria-label="メインナビ">
  <%= link_to root_path,
              class: "nav-item #{'active' if active == :home}",
              aria: { current: ('page' if active == :home) } do %>
    <span class="nav-icon">🏠</span>
    <span class="nav-label">ホーム</span>
  <% end %>

  <%= link_to snacks_path,
              class: "nav-item #{'active' if active == :list}",
              aria: { current: ('page' if active == :list) } do %>
    <span class="nav-icon">📋</span>
    <span class="nav-label">一覧</span>
  <% end %>

  <%= link_to new_snack_path,
              class: "nav-item #{'active' if active == :record}",
              aria: { current: ('page' if active == :record) } do %>
    <span class="nav-icon">＋</span>
    <span class="nav-label">記録</span>
  <% end %>

  <%= link_to settings_path,
              class: "nav-item #{'active' if active == :settings}",
              aria: { current: ('page' if active == :settings) } do %>
    <span class="nav-icon">⚙</span>
    <span class="nav-label">設定</span>
  <% end %>
</nav>
