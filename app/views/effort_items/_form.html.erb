<%= form_with model: effort_item, class: "effort-item-form" do |f| %>
  <% if effort_item.errors.any? %>
    <ul class="form-errors">
      <% effort_item.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="field">
    <%= f.label :name, class: "field-label" %>
    <%= f.text_field :name, class: "input", maxlength: 30,
                            placeholder: "例: 1日10000歩あるく" %>
  </div>

  <div class="field" data-controller="stepper"
       data-stepper-min-value="1" data-stepper-max-value="10">
    <%= f.label :coins_per_check, class: "field-label" %>
    <div class="stepper">
      <button type="button" class="stepper-btn" data-action="click->stepper#dec">−</button>
      <%= f.number_field :coins_per_check, min: 1, max: 10,
                                           class: "stepper-input",
                                           data: { stepper_target: "input" } %>
      <button type="button" class="stepper-btn" data-action="click->stepper#inc">＋</button>
    </div>
  </div>

  <%= f.hidden_field :position %>

  <%= f.submit class: "btn-primary" %>
<% end %>
