<%# locals: (item:, locked: false) %>
<%
  already_checked = item.checked_on?
  done_class = (locked && already_checked) ? "done" : nil
  disabled   = locked
%>
<li class="effort-row <%= done_class %> <%= 'locked' if locked %>">
  <div class="effort-text">
    <p class="effort-name"><%= item.name %></p>
    <p class="effort-meta">
      <span class="coin" aria-hidden="true">🪙</span>
      <span class="coin-amount">+<%= item.coins_per_check %> コイン</span>
    </p>
  </div>

  <label class="check-wrap"
         aria-label="<%= locked ? '今日は確定済みです' : '今日達成したらチェック' %>">
    <%= check_box_tag "effort_item_ids[]",
                      item.id,
                      already_checked,
                      disabled: disabled,
                      id: "effort_item_#{item.id}",
                      class: "check-input",
                      data: { action: ("change->daily-checkin#updateCounter" unless locked) } %>
    <span class="check check-display <%= 'checked' if already_checked %>"
          aria-hidden="true"></span>
  </label>
</li>
