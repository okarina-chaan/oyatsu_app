<% content_for :title, "おやつ貯金" %>

<div class="app-shell">
  <header class="topbar">
    <div>
      <h1>
        <span class="piggy-mini" aria-hidden="true">🐷</span>
        <span>おやつ貯金</span>
      </h1>
      <p class="sub"><%= l(Date.current, format: :long) %> · 今日もえらい！</p>
    </div>
  </header>

  <main class="content">
    <%= render "shared/flash" %>

    <%# ====== 貯金箱カード ====== %>
    <%= render "balance",
               balance: @balance, cost: @cost,
               remaining: @remaining, progress: @progress %>

    <%# ====== 頑張り項目 (確定前はチェックボックス、確定後は固定表示) ====== %>
    <%= form_with url: daily_checkin_path,
                  method: :post,
                  class: "daily-checkin-form",
                  data: { controller: "daily-checkin",
                          daily_checkin_checked_in_value: @checked_in_today } do %>
      <section>
        <h2 class="section-title">
          <span class="pip"></span>
          今日の頑張り
          <% if @checked_in_today %>
            <span class="muted">確定済み 🎀</span>
          <% else %>
            <span class="muted" data-daily-checkin-target="counter">
              <%= @effort_items.count(&:checked_on?) %> / <%= @effort_items.size %>
            </span>
          <% end %>
        </h2>

        <ul class="effort-list">
          <% @effort_items.each do |item| %>
            <%= render "effort_row",
                       item: item,
                       locked: @checked_in_today %>
          <% end %>
        </ul>

        <% if @effort_items.empty? %>
          <p class="muted">
            まだ頑張り項目がありません。
            <%= link_to "設定から追加", settings_path %>しましょう。
          </p>
        <% end %>
      </section>

      <%# ====== 「今日もがんばった！」ボタン ====== %>
      <% if @effort_items.any? %>
        <div class="callout-cta">
          <% if @checked_in_today %>
            <button type="button"
                    class="btn-primary btn-locked"
                    disabled
                    aria-disabled="true">
              今日もがんばった！ ✓
            </button>
            <p class="muted" style="margin-top: 6px;">
              また明日、続きをがんばろう！
            </p>
          <% else %>
            <%= submit_tag "今日もがんばった！",
                           class: "btn-primary",
                           data: { daily_checkin_target: "submit" } %>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <%# ====== おやつタイム導線 ====== %>
    <% if @remaining.zero? %>
      <p class="callout-cta">
        <%= link_to "おやつを記録する 🎀", new_snack_path, class: "btn-primary" %>
      </p>
    <% end %>
  </main>

  <%= render "shared/bottom_nav", active: :home %>
</div>
