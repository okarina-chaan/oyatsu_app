# npm サプライチェーン攻撃 (Mini Shai-Hulud 等) 対策。
# postinstall / preinstall / install スクリプトを実行しないことで、
# 汚染パッケージが取り込まれても任意コード実行を防ぐ。
#
# 注意: 一部のパッケージはネイティブ拡張の build などを install スクリプトに頼る。
# このプロジェクトの依存 (@hotwired/*, daisyui, tailwindcss, esbuild) は
# どれもプレビルド配布されており、ignore-scripts でも動作に支障なし。
# 新規にパッケージを追加するとき、install スクリプトが必要な場合のみ
# `npm install <pkg> --ignore-scripts=false` で例外的に許可する運用。

ignore-scripts=true

# 監査の厳しさ: 既知脆弱性は moderate 以上で audit エラーとして扱う
audit-level=moderate

# install 時に save-exact (^ ではなく ==) にしたい場合は次行のコメントを外す
# save-exact=true
